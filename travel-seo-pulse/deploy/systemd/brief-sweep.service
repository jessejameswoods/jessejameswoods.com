[Unit]
Description=Sweep: unpublish ANY stale Travel Search Pulse Daily post still live
OnFailure=brief-unpublish-alarm.service
ConditionPathExists=/etc/travel-seo-pulse.env
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=/etc/travel-seo-pulse.env
ExecStart=/opt/travel-seo-pulse/.venv/bin/python /usr/local/bin/tsp_unpublish.py sweep
